# ==============================================================================
# COMPLEJO DEPORTIVO UB - VARIABLES DE ENTORNO (EJEMPLO)
# Copia este archivo a ".env" en la raíz del backend y ajusta los valores locales:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP Y ENTORNO
# ------------------------------------------------------------------------------
# Puerto donde escuchará la API REST (Opcional, por defecto 4000)
PORT=4000

# Entorno de ejecución: 'development' | 'production' | 'test' (Opcional, defecto 'development')
NODE_ENV=development

# URL origen permitida para solicitudes CORS del frontend (Opcional, por defecto *)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS MYSQL (Obligatorias para persistencia)
# ------------------------------------------------------------------------------
# Host de MySQL (ej. localhost en local, o 'db' si se corre en Docker)
DB_HOST=localhost

# Puerto del servicio MySQL (por defecto 3306)
DB_PORT=3306

# Nombre del usuario de MySQL con permisos en la base de datos
DB_USER=root

# Contraseña de acceso a MySQL (ejemplo ficticio: reemplaza por tu contraseña local)
DB_PASSWORD=tu_password_local_mysql

# Nombre de la base de datos relacional (definida en database/schema.sql)
DB_NAME=complejo_deportivo

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN Y SEGURIDAD JWT (OBLIGATORIA)
# ------------------------------------------------------------------------------
# Clave secreta criptográfica para la firma y verificación de tokens JWT.
# OBLIGATORIA: El servidor rechazará el inicio si esta clave no está definida o está vacía.
# Genera una cadena aleatoria y segura para producción (mínimo 32 caracteres).
JWT_SECRET=tu_clave_secreta_jwt_ficticia_ejemplo_ub_2026

# Tiempo de expiración de la sesión (ej. '7d', '24h', '2h')
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. SERVICIO DE CORREO ELECTRONICO (SMTP / Nodemailer) (Opcional)
# Si no se configuran credenciales SMTP, el backend activará automáticamente
# el modo desarrollo con simulación por consola / Ethereal Mail para pruebas.
# ------------------------------------------------------------------------------
# Servidor SMTP (ej. smtp.gmail.com para Gmail, o smtp.mailtrap.io para pruebas)
SMTP_HOST=smtp.ejemplo.com

# Puerto SMTP (587 para TLS/STARTTLS, 465 para SSL seguro)
SMTP_PORT=587

# Usuario o cuenta de correo remitente
SMTP_USER=usuario_correo@ejemplo.com

# Contraseña de correo o Contraseña de Aplicación de 16 caracteres (para Gmail App Passwords)
SMTP_PASSWORD=tu_contrasena_de_aplicacion_aqui

# Dirección que aparecerá en el encabezado 'From'
SMTP_FROM_EMAIL=no-reply@complejoub.com

# Nombre visible del remitente
SMTP_FROM_NAME=Complejo Deportivo UB

# ------------------------------------------------------------------------------
# 5. SCRIPTS DE ADMINISTRACION (Opcional)
# ------------------------------------------------------------------------------
# Contraseña para inicializar la cuenta del Superadministrador al ejecutar scripts/add_superadmin.ts
INITIAL_SUPERADMIN_PASSWORD=ContrasenaSuperadmin123!

